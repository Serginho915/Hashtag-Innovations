DJANGO_SECRET_KEY=change-me
ADMIN_SESSION_SECRET=change-me-admin-session-secret
ADMIN_API_TOKEN=change-me-internal-admin-api-token
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Europe/Sofia
DJANGO_SQLITE_NAME=db.sqlite3
FRONTEND_BASE_URL=http://localhost:3000
BACKEND_INTERNAL_API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_CURRENCY=eur
OPENROUTER_API_KEY=replace_me
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_IMAGE_MODEL=openai/gpt-image-2
AI_INSIGHTS_PROMPT="Create one publish-ready business insight for the Hashtag Innovations audience. Choose a fresh topic from business strategy, AI adoption, digital transformation, startup growth, operations, education, sustainability, or innovation. Return English and Bulgarian versions. Do not mention or invent an author."
AI_INSIGHTS_INTERVAL_DAYS=1
AI_INSIGHTS_CHECK_SECONDS=300
AI_INSIGHTS_TEMPERATURE=0.8
AI_INSIGHTS_MAX_TOKENS=12000
AI_INSIGHTS_IMAGE_QUALITY=high
AI_INSIGHTS_IMAGE_ASPECT_RATIO=16:9
AI_INSIGHTS_IMAGE_RESOLUTION=1K
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=replace_with_google_workspace_email
EMAIL_HOST_PASSWORD=replace_with_google_workspace_app_password
EMAIL_TIMEOUT=30
DEFAULT_FROM_EMAIL="Hashtag Innovations <replace_with_google_workspace_email>"
MATERIAL_DELIVERY_FROM_EMAIL="Hashtag Innovations <replace_with_google_workspace_email>"
